{
  "name": "hai",
  "private": true,
  "description": "Open-source hand, face and voice interaction layer for AI-assisted AEC design.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "licenses:check": "node scripts/check-licenses.mjs",
    "credentials:check": "node scripts/credential-boundary.mjs",
    "assets": "node scripts/fetch-assets.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
