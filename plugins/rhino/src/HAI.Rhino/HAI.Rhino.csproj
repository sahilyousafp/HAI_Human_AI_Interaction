<Project Sdk="Microsoft.NET.Sdk">

  <!-- The HAI plugin for Rhino 8 and Rhino 9. net8.0 is what Rhino's .NET Core runtime loads, and net48 is for a Rhino 8
       started on .NET Framework; McNeel's own RhinoAI plugin targets the same two. It compiles against Rhino 8's
       RhinoCommon, so it uses nothing that is new in Rhino 9. RhinoCommon is a compile-time reference only: Rhino supplies
       its own at run time, and so does it Newtonsoft.Json. -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>HAI.Rhino</RootNamespace>
    <AssemblyName>HAI.Rhino</AssemblyName>
    <TargetExt>.rhp</TargetExt>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.19.25132.1001" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
    <ProjectReference Include="..\HAI.Rhino.Core\HAI.Rhino.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
