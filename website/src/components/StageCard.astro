---
import type { CollectionEntry } from "astro:content";

interface Props {
  stage: CollectionEntry<"stages">;
}
const { stage } = Astro.props;
const d = stage.data;
const num = String(d.order).padStart(2, "0");
const posted = d.date.toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" });
const action = d.video ? "Watch the clip" : "See the research";
---

<a class="card" href={`/stage/${stage.id}/`} data-card>
  <div class="media">
    <video
      muted
      loop
      playsinline
      preload="none"
      poster={`/media/${stage.id}-preview.webp`}
      aria-hidden="true"
      tabindex="-1"
      data-preview
    >
      <source src={`/media/${stage.id}-preview.mp4`} type="video/mp4" />
    </video>
  </div>
  <div class="body">
    <p class="top meta">
      <span class="num">{num}</span>
      <span class="week">{d.week}</span>
      <time datetime={d.date.toISOString().slice(0, 10)}>{posted}</time>
    </p>
    <h3 class="title">{d.title}</h3>
    <p class="summary">{d.summary}</p>
    <span class="go">{action} <span class="arrow" aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--r-panel);
    background: var(--sheet);
    transition: border-color 0.4s var(--ease), transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  .card:hover {
    border-color: var(--hairline-2);
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -24px #16181c40;
  }
  .card:active { transform: translateY(-2px) scale(0.995); }

  .media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
    background: var(--media-bg);
  }
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .card:hover video { transform: scale(1.03); }

  .body { display: flex; flex-direction: column; flex: 1; gap: 10px; padding: 20px 22px 22px; }
  .top { display: flex; align-items: center; gap: 10px; margin: 0; }
  .num { color: var(--accent); font-weight: 500; }
  .week {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border: 1px solid var(--hairline-2);
    border-radius: 999px;
    color: var(--graphite-2);
  }
  time { margin-left: auto; }
  .title { font-size: clamp(22px, 1.9vw, 26px); letter-spacing: -0.018em; line-height: 1.15; }
  .summary {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--stone);
    font-size: 15.5px;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 8px;
    font-size: 15px;
    font-weight: 500;
  }
  .go .arrow { transition: transform 0.5s var(--ease); }
  .card:hover .go { color: var(--accent); }
  .card:hover .go .arrow { transform: translateX(4px); }

  @media (prefers-reduced-motion: reduce) {
    .card:hover, .card:hover video { transform: none; }
  }
</style>
